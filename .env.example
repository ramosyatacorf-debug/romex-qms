# ===========================================
# RomEx QMS — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local a Git.
# ===========================================

# —— Qualy AI · Azure OpenAI (opcional) ——
# Si estas 3 variables están definidas, Qualy usa Azure.
# Si faltan, usa el cerebro local automáticamente.
#
# Cómo obtenerlas: ver guía en el chat / documentación del proyecto.

# Ejemplo endpoint: https://TU-RECURSO.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Clave del recurso Azure OpenAI (Keys and Endpoint en el portal)
AZURE_OPENAI_API_KEY=

# Nombre del deployment (ej: gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT=

# Versión de API (recomendado dejar este valor)
AZURE_OPENAI_API_VERSION=2024-08-01-preview
